# The demo portal's settings. Copy to demo/demo.env (chmod 600: it holds the tunnel's token).

# The amc-webapp checkout whose compose files it uses, and whose images
# (amc-web, amc-auth) must already be built there. The demo never builds.
AMC_WEBAPP_DIR=/opt/amc-webapp

# The public address, and the token of the demo's own Cloudflare tunnel.
AMC_PUBLIC_HOST=amc-demo.rjana.in
# The second origin is for an admin over SSH (ssh -L 8092:127.0.0.1:8092 server).
AMC_ORIGINS=https://amc-demo.rjana.in,https://localhost:8092
AMC_TUNNEL_TOKEN=

# Sign-in data and logs. AMC_DEMO_FILES is the fixed-size disk for the exams;
# leave it out for a plain Docker volume (for a test on a laptop).
AMC_DATA_DIR=/opt/amc-demo-data
AMC_DEMO_FILES=/opt/amc-demo-data/files

# Its private address, on this machine only: for demo.sh's checks and an admin
# over SSH. Not production's port.
AMC_PORT=8092
AMC_BIND=127.0.0.1
AMC_SITES=https://localhost:8092
AMC_DEFAULT_SNI=localhost

# Limits, and who the app runs as.
AMC_MEMORY=512m
AMC_CPUS=1
AMC_ISOLATE=1
AMC_UID=1000
AMC_GID=0
TZ=Asia/Kolkata

# The account printed on rjana.in/amc and in the user guide, and what the portal calls itself.
DEMO_USER=demo_instructor
DEMO_PASS='Demo@1234!4567'
DEMO_SCHOOL='AMC Demo: resets every night'
DEMO_COLOR='#3b5bdb'
